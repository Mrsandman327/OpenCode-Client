# 构建产物
build/*
# wails3 build 的输出目录（Taskfile 的 BIN_DIR），含十几 MB 的 exe，不应入库
bin/
# Task (go-task) 的任务校验缓存
.task/
# 运行期日志目录（logger.CreateSysLog 写入 ./log/）
log/

# 系统文件
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
.sisyphus/

# Windows 资源文件（图标嵌入）
*.syso

# 日志
*.log
skmgr-tray.log

# 临时文件
tmp_*
my/
assets/