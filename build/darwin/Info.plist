<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundlePackageType</key>
            <string>APPL</string>
        <key>CFBundleName</key>
            <string>OC Manager</string>
        <key>CFBundleDisplayName</key>
            <string>OC Manager</string>
        <key>CFBundleExecutable</key>
            <string>oc-manager</string>
        <key>CFBundleIdentifier</key>
            <string>com.linsn.ocmanager</string>
        <key>CFBundleVersion</key>
            <string>2.0.4</string>
        <key>CFBundleGetInfoString</key>
            <string>OpenCode 全能工作台</string>
        <key>CFBundleShortVersionString</key>
            <string>2.0.4</string>
        <key>CFBundleIconFile</key>
            <string>icons</string>
        <key>CFBundleIconName</key>
            <string>appicon</string>
        <key>LSMinimumSystemVersion</key>
            <string>12.0.0</string>
        <key>NSHighResolutionCapable</key>
            <string>true</string>
        <key>NSHumanReadableCopyright</key>
            <string>(c) 2026, Linsn</string>
        <!-- 允许 WebView 访问本机 127.0.0.1 上的 opencode 服务 -->
        <key>NSAppTransportSecurity</key>
        <dict>
            <key>NSAllowsLocalNetworking</key>
            <true/>
        </dict>
        <!-- process_darwin.go 用 osascript 控制 Terminal 打开 opencode，
             缺少本描述时 macOS 的 TCC 会直接拒绝自动化请求 -->
        <key>NSAppleEventsUsageDescription</key>
            <string>OC Manager 需要在外部终端中打开 OpenCode，请允许控制“终端”。</string>
    </dict>
</plist>
