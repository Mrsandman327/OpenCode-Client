<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="oc-manager.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Linsn\OC Manager">
    </Installer>
    <PackageInformation
        PackageName="Linsn.OCManager"
        PackageDisplayName="OC Manager"
        PublisherName="CN=Linsn"
        PublisherDisplayName="Linsn"
        Version="2.0.4.0"
        PackageDescription="OpenCode 全能工作台">
        <Capabilities>
            <Capability Name="runFullTrust" />
        </Capabilities>
        <Applications>
            <Application
                Id="com.linsn.ocmanager"
                Description="OpenCode 全能工作台"
                DisplayName="OC Manager"
                ExecutableName="oc-manager.exe"
                EntryPoint="Windows.FullTrustApplication">
            </Application>
        </Applications>
        <Resources>
            <Resource Language="zh-CN" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>OC Manager</DisplayName>
            <PublisherDisplayName>Linsn</PublisherDisplayName>
            <Description>OpenCode 全能工作台</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="oc-manager.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
